#!/usr/bin/env python3
"""Flash a raw binary to the target through the AVR shell.

    tools/swdflash firmware.bin [address]

Drives the same commands you would type (unlock, then the XMODEM loader) and
sends the file itself. Doing the transfer here rather than handing the port to
sx avoids the shell's own command echo being mistaken for protocol bytes.

The firmware erases each sector as the transfer reaches it and verifies every
block, so a report of success here means the flash really matches the file.
"""

import os
import sys
import termios
import time

SOH, EOT, ACK, NAK, CAN = 0x01, 0x04, 0x06, 0x15, 0x18
BLOCK = 128


def open_port(path):
    fd = os.open(path, os.O_RDWR | os.O_NOCTTY)
    a = termios.tcgetattr(fd)

    iflag, oflag, cflag, lflag, ispeed, ospeed, cc = a

    iflag = 0
    oflag = 0
    lflag = 0
    cflag = termios.CS8 | termios.CREAD | termios.CLOCAL
    # Leave HUPCL off so closing the port does not reset the host board.
    cflag &= ~termios.HUPCL

    cc = list(cc)
    cc[termios.VMIN] = 0
    cc[termios.VTIME] = 1  # 0.1s granularity on reads

    termios.tcsetattr(fd, termios.TCSANOW,
                      [iflag, oflag, cflag, lflag,
                       termios.B115200, termios.B115200, cc])
    return fd


def read_byte(fd, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        data = os.read(fd, 1)
        if data:
            return data[0]
    return None


def drain(fd, seconds=1.0, echo=False):
    deadline = time.time() + seconds
    out = bytearray()
    while time.time() < deadline:
        data = os.read(fd, 256)
        if data:
            out += data
            deadline = time.time() + 0.3
    if echo and out:
        sys.stdout.write(out.decode("ascii", "replace"))
        sys.stdout.flush()
    return bytes(out)


def send_line(fd, text):
    os.write(fd, (text + "\r").encode())


def wait_for_prompt(fd, timeout):
    """Reads until the shell offers a prompt, which is the only reliable sign
    it is listening. Sleeping for a guessed interval races the bootloader,
    which eats anything sent before the firmware starts."""
    buf = bytearray()
    deadline = time.time() + timeout

    while time.time() < deadline:
        data = os.read(fd, 64)
        if data:
            buf += data
            if buf.endswith(b"> "):
                return buf.decode("ascii", "replace")

    return None


def send_file(fd, data):
    blocks = (len(data) + BLOCK - 1) // BLOCK

    for index in range(blocks):
        chunk = data[index * BLOCK:(index + 1) * BLOCK]
        chunk = chunk.ljust(BLOCK, b"\x1a")
        number = (index + 1) & 0xFF
        packet = (bytes([SOH, number, 0xFF - number]) + chunk
                  + bytes([sum(chunk) & 0xFF]))

        for attempt in range(8):
            os.write(fd, packet)
            reply = read_byte(fd, 8.0)

            if reply == ACK:
                break
            if reply == CAN:
                # The firmware cancels on a flash failure and then explains
                # itself on the same line, so let the caller read that.
                print()
                return "cancelled at block %d" % (index + 1)
        else:
            return "no ACK for block %d" % (index + 1)

        done = index + 1
        sys.stdout.write("\r  %d/%d blocks" % (done, blocks))
        sys.stdout.flush()

    print()

    for _ in range(8):
        os.write(fd, bytes([EOT]))
        if read_byte(fd, 2.0) == ACK:
            return None

    return "no ACK for EOT"


def main():
    if len(sys.argv) < 2:
        print("usage: %s <file.bin> [address]" % sys.argv[0], file=sys.stderr)
        return 1

    path = sys.argv[1]
    address = sys.argv[2] if len(sys.argv) > 2 else "08000000"
    port = os.environ.get("PORT", "/dev/ttyACM0")

    with open(path, "rb") as handle:
        data = handle.read()

    print("%s, %d bytes to 0x%s via %s" % (path, len(data), address, port))

    fd = open_port(port)
    try:
        # Do not assume the board just reset. Opening the port usually resets
        # it, but not once HUPCL has been cleared, and then it is already
        # sitting at a prompt and will say nothing until spoken to. Nudging
        # with a bare line works either way: during boot the nudge is eaten and
        # the next one lands.
        timeout = float(os.environ.get("BOOT_WAIT", "20"))
        print("waiting for the shell")

        banner = None
        deadline = time.time() + timeout

        while time.time() < deadline and banner is None:
            send_line(fd, "")
            banner = wait_for_prompt(fd, 1.5)

        if banner is None:
            raise RuntimeError("no prompt from the host after %.0fs" % timeout)

        print("host:", " ".join(banner.split()) or "(prompt)")

        # Connect first. Sending 'u' straight away assumes the debug port is
        # already up and no sticky error is latched, which stops being true
        # the moment the target faults: unlock then fails with ack=0x04 and
        # says nothing about why. Connecting powers the debug domain up and
        # clears the error flags. Halting matters too, because a target with
        # no valid code in flash is off in a fault handler.
        send_line(fd, "c")
        reply = wait_for_prompt(fd, 5.0)

        if reply is None or "ok" not in reply:
            raise RuntimeError("connect not acknowledged: %r" % (reply,))

        print("connect: ok")

        # Reset, not just halt. FLASH_KEYR takes two key writes in sequence,
        # and a wrong or out of order value raises a bus error and locks the
        # controller until the next reset. So a run that faults between the
        # two keys leaves the controller waiting for the second one, and every
        # later attempt starts with what is now the wrong key and locks it
        # again. Resetting puts that state machine back to a known point, and
        # halting on the way out keeps a target with no valid code in flash
        # from running off into a fault handler.
        send_line(fd, "t")
        reply = wait_for_prompt(fd, 5.0)

        if reply is None or "ok" not in reply:
            raise RuntimeError("reset not acknowledged: %r" % (reply,))

        print("reset and halt: ok")

        send_line(fd, "u")
        reply = wait_for_prompt(fd, 5.0)

        if reply is None or "ok" not in reply:
            raise RuntimeError("unlock not acknowledged: %r" % (reply,))

        print("unlock: ok")

        send_line(fd, "l " + address)

        # Swallow the echo and banner, and stop at the loader's first NAK. The
        # loader keeps NAKing once a second, so consuming one costs nothing.
        deadline = time.time() + 30
        while time.time() < deadline:
            byte = read_byte(fd, 1.0)
            if byte == NAK:
                break
        else:
            raise RuntimeError("the loader never started")

        problem = send_file(fd, data)

        time.sleep(0.5)
        report = drain(fd, 3.0).decode("ascii", "replace").strip()
        if report:
            print(report)

        if problem:
            print("\nfailed: %s" % problem, file=sys.stderr)
            return 1

        print("\ndone. 'q' in the shell resets and runs it.")
    finally:
        os.close(fd)

    return 0


if __name__ == "__main__":
    sys.exit(main())
